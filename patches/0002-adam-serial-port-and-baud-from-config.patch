     ss << "baud=" << _serial.baud << LINETERM;
-#endif
 #ifdef BUILD_ATARI
     ss << "command=" << std::string(_serial_command_pin_names[_serial.command]) << LINETERM;
     ss << "proceed=" << std::string(_serial_proceed_pin_names[_serial.proceed]) << LINETERM;
