diff --git a/lib/bus/adamnet/adamnet.cpp b/lib/bus/adamnet/adamnet.cpp
index 877f6596c..a1ed8c052 100755
--- a/lib/bus/adamnet/adamnet.cpp
+++ b/lib/bus/adamnet/adamnet.cpp
@@ -520,10 +520,24 @@ void systemBus::setup()
     }
     else
     {
+        // A real serial port: the one [Serial] names, at its baud (the MiSTer
+        // core's AdamNet master runs the link at the UART speed the OSD picks;
+        // without a configured baud, the bus's own 62,500).
+        int baud = Config.get_serial_baud();
+        // readTimeout is per chunk of a packet. 2 ms is fine for a UART FIFO,
+        // but a Linux tty hands bytes up from the line discipline's work queue
+        // and can sit on the tail of a 9 byte packet for several ms (seen on a
+        // MiSTer, kernel 6.18: the length bytes arrived, the payload did not,
+        // and every block read was NAKed). The master waits 300 ms for us.
+        // No discard window either: on the one-wire bus it drops the echo of
+        // our own reply, but a tty is two wires with no echo, and on Linux
+        // flushOutput() returns late enough (tcdrain sleeps in jiffies) that
+        // the window would swallow the master's next command instead.
         _serial.begin(ChannelConfig()
-                    .baud(ADAMNET_BAUDRATE)
-                    .readTimeout(2.0)
-                    .discardTimeout(0.180)
+                    .deviceID(Config.get_serial_port())
+                    .baud(baud > 0 ? baud : ADAMNET_BAUDRATE)
+                    .readTimeout(100)
+                    .discardTimeout(0)
                     );
         _port = &_serial;
     }
