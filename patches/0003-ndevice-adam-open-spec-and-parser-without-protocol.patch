+// FCh: [mode], 0 protocol, 1 JSON... (FujiNet Programming Guide for the ADAM)
+void adamNetwork::fujidev_set_parser(const FUJI_COMMAND_PACKET &packet)
+{
+    SYSTEM_BUS.transaction_accept(TRANS_STATE::NO_GET);
+
+    parserMode_t mode = param_cast<parserMode_t>(packet, 0);
+    if (fujicore_set_parser(mode).is_error())
+        SYSTEM_BUS.transaction_error();
+    else
+        SYSTEM_BUS.transaction_success();
+}
+
+// 'M': [mode], body or headers
+void adamNetwork::fujidev_http_set_channel_mode(const FUJI_COMMAND_PACKET &packet)
+{
+    NetworkProtocolHTTP *http = dynamic_cast<NetworkProtocolHTTP *>(_protocol.get());
+    if (!http)
+    {
+        SYSTEM_BUS.transaction_error();
+        return;
+    }
+
+    SYSTEM_BUS.transaction_accept(TRANS_STATE::NO_GET);
+
+    auto mode = param_cast<netProtoHTTPChannelMode_t>(packet, 0);
+    if (http->set_channel_mode(mode) != FUJI_ERROR::NONE)
+        SYSTEM_BUS.transaction_error();
+    else
+        SYSTEM_BUS.transaction_success();
+}
+
 #endif /* BUILD_ADAM */
